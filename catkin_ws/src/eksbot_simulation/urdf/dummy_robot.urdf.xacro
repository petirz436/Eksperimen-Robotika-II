<?xml version="1.0"?>
<robot name="dummy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- MATERIALS -->
  <material name="chassis_color"><color rgba="0.8 0.8 0.85 1.0"/></material>
  <material name="wheel_color"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="mast_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="gripper_color"><color rgba="0.9 0.2 0.2 1.0"/></material>
  <material name="camera_color"><color rgba="0.1 0.1 0.4 1.0"/></material>

  <!-- BASE LINK -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.22 0.22 0.08"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.22 0.22 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- LEFT WHEEL -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.12 -0.01" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>10.0</mu>
            <mu2>10.0</mu2>
            <kp>1000000.0</kp>
            <kd>10.0</kd>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- RIGHT WHEEL -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.12 -0.01" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>10.0</mu>
            <mu2>10.0</mu2>
            <kp>1000000.0</kp>
            <kd>10.0</kd>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- FRONT CASTER (Frictionless Glider - Zero Drag) -->
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.08 0 -0.029" rpy="0 0 0"/>
  </joint>

  <link name="front_caster">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.019"/></geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.0</mu>
            <mu2>0.0</mu2>
            <slip1>1.0</slip1>
            <slip2>1.0</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- REAR CASTER (Frictionless Glider - Zero Drag) -->
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.08 0 -0.029" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.019"/></geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.0</mu>
            <mu2>0.0</mu2>
            <slip1>1.0</slip1>
            <slip2>1.0</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- VERTICAL LIFT MAST -->
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="0.06 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.03 0.04 0.30"/></geometry>
      <material name="mast_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.03 0.04 0.30"/></geometry>
    </collision>
  </link>

  <!-- LIFT SLIDER (PRISMATIC JOINT FOR SERVO ELEVATION) -->
  <joint name="lift_joint" type="prismatic">
    <parent link="mast_link"/>
    <child link="lift_carriage"/>
    <origin xyz="0.02 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.22" effort="10.0" velocity="0.1"/>
  </joint>

  <link name="lift_carriage">
    <visual>
      <geometry><box size="0.04 0.06 0.04"/></geometry>
      <material name="gripper_color"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.06 0.04"/></geometry>
    </collision>
  </link>

  <!-- GRIPPER FINGER LEFT -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="lift_carriage"/>
    <child link="left_finger"/>
    <origin xyz="0.04 0.03 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.01" upper="0.03" effort="5.0" velocity="0.05"/>
  </joint>

  <link name="left_finger">
    <visual>
      <geometry><box size="0.06 0.01 0.03"/></geometry>
      <material name="gripper_color"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.01 0.03"/></geometry>
      <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
    </collision>
  </link>

  <!-- GRIPPER FINGER RIGHT -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="lift_carriage"/>
    <child link="right_finger"/>
    <origin xyz="0.04 -0.03 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.01" upper="0.03" effort="5.0" velocity="0.05"/>
  </joint>

  <link name="right_finger">
    <visual>
      <geometry><box size="0.06 0.01 0.03"/></geometry>
      <material name="gripper_color"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.01 0.03"/></geometry>
      <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
    </collision>
  </link>

  <!-- ESP32-CAM MOUNT & CAMERA SENSOR -->
  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0.01 0 0.31" rpy="0 0.60 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="camera_color"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_link_optical"/>

  <!-- GAZEBO PLUGINS -->
  <!-- 1. Differential Drive Controller -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <rosDebugLevel>na</rosDebugLevel>
      <updateRate>50</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.24</wheelSeparation>
      <wheelDiameter>0.08</wheelDiameter>
      <wheelAcceleration>10.0</wheelAcceleration>
      <wheelTorque>30</wheelTorque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
    </plugin>
  </gazebo>

  <!-- 2. ESP32-CAM Gazebo Camera Sensor Plugin -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="esp32_cam">
      <update_rate>30.0</update_rate>
      <camera name="esp32_cam">
        <horizontal_fov>1.1</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link_optical</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 3. Gazebo Vacuum Gripper Mechanism for 3D Cube Grip & Release -->
  <gazebo>
    <plugin name="gazebo_ros_vacuum_gripper" filename="libgazebo_ros_vacuum_gripper.so">
      <robotNamespace>/dummy_robot</robotNamespace>
      <bodyName>lift_carriage</bodyName>
      <topicName>gripper_switch</topicName>
      <maxForce>50.0</maxForce>
      <maxDistance>0.15</maxDistance>
    </plugin>
  </gazebo>

</robot>
